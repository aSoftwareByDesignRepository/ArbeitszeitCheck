{
    "name": "nextcloud/arbeitszeitcheck",
    "description": "DACH labour-law compliant time tracking (ArbZG / AZG / ArG) and GDPR for Nextcloud",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Alexander M\u00e4ule",
            "email": "info@software-by-design.de",
            "homepage": "http://nextcloud.software-by-design.de"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "nextcloud/ocp": "^32.0 || ^33.0 || ^34.0 || ^35.0"
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:docker": "bash ../../docker/run-app-phpunit.sh arbeitszeitcheck",
        "test:security-role-gating:docker": "bash scripts/test-security-role-gating-docker.sh",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:coverage": "phpunit --coverage-html tests/coverage",
        "lint": "@php -l lib",
        "analyze": "@php -l lib"
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "platform": {
            "php": "8.1"
        }
    },
    "autoload": {
        "psr-4": {
            "OCA\\ArbeitszeitCheck\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\ArbeitszeitCheck\\Tests\\": "tests/"
        }
    }
}
